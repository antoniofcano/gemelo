# Imagen del hornero CON impostores (ADR-0019 §2, O8b): el mismo servicio (servicio.mjs) que tuberia/olivos/Dockerfile, sobre la imagen
# OFICIAL de Playwright, que trae Chrome (chromium-headless-shell) y sus bibliotecas. Fijada por versión y digest: la versión es la de
# playwright-core de tuberia/olivos/package.json (1.64.1), y el Chrome de la imagen entra en la clave de cada impostor por esa versión
# (impostores.mjs, claveDe): cambiar la imagen = cambiar package.json y este FROM en el mismo commit.
# La imagen alpine de siempre (Dockerfile) se queda como está y no hornea impostores (conserva los que sigan valiendo).
# Contexto de construcción: la raíz del repo. NO PROBADA aún (ni construida ni arrancada): ver contratos/olivo-impostor.md §6.
FROM mcr.microsoft.com/playwright:v1.64.1-noble@sha256:47b510dd9230bf0b9bfc9b20102241e577ea7a99334ab4c3ca19f19770e9b8ea
ENV NODE_ENV=production \
    GEMELO_HORNERO_DATOS=/datos \
    GEMELO_HORNERO_SALIDA=/salida \
    GEMELO_HORNERO_ESTADO=/estado \
    GEMELO_HORNERO_IMPOSTORES=1
WORKDIR /app
# ajv, proper-lockfile, sharp (WebP), three 0.186.1 (la página de horneado) y playwright-core del hornero
COPY tuberia/olivos/package.json tuberia/olivos/package-lock.json ./tuberia/olivos/
RUN cd tuberia/olivos && npm ci --omit=dev --no-audit --no-fund
# el constructor de olivos con su three 0.128 (three-gen) e idb-keyval
COPY apps/web/olivo/package.json apps/web/olivo/package-lock.json ./apps/web/olivo/
RUN cd apps/web/olivo && npm ci --omit=dev --no-audit --no-fund
COPY apps/web/olivo/*.js ./apps/web/olivo/
COPY apps/web/olivo/texturas ./apps/web/olivo/texturas
COPY contratos/hornero-manifiesto.schema.json contratos/epocas-calendario.json ./contratos/
COPY tuberia/olivos/hornero.mjs tuberia/olivos/servicio.mjs tuberia/olivos/salud.mjs tuberia/olivos/impostores.mjs ./tuberia/olivos/
COPY tuberia/olivos/impostores ./tuberia/olivos/impostores
# validaManifiesto busca ajv desde la raíz: el package.json del hornero hace de raíz
RUN cp tuberia/olivos/package.json ./package.json && ln -s tuberia/olivos/node_modules node_modules
RUN mkdir -p /estado /salida /datos && chown pwuser:pwuser /estado /salida
USER pwuser
CMD ["node", "tuberia/olivos/servicio.mjs"]
