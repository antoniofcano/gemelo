{
  "name": "gemelo",
  "version": "0.2.0",
  "private": true,
  "description": "Gemelo digital en 3D de fincas de olivar (three.js r128, teselas de 256 m, LiDAR, modo VR)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "fixture": "python pruebas/genera_fixture.py",
    "montar": "python tuberia/salida_artefacto/montar_v2.py",
    "guardianes": "node --test \"pruebas/guardianes/*.test.js\"",
    "puerta": "node --test --test-concurrency=1 \"pruebas/guardianes/*.test.js\"",
    "probar": "node pruebas/prueba3.js",
    "probar:vr": "node pruebas/vr_mock.js",
    "dev:arriba": "node infra/dev/herramientas/levanta.mjs",
    "dev:abajo": "node infra/dev/herramientas/para.mjs",
    "dev:estado": "node infra/dev/herramientas/estado.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "ajv": "8.20.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright-core": "^1.48.0"
  }
}
