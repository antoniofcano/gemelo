{
  "name": "gemelo",
  "version": "0.2.0",
  "private": true,
  "description": "Gemelo digital en 3D de fincas de olivar (three.js 0.186.1, teselas de 256 m, LiDAR, modo VR)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "fixture": "python pruebas/genera_fixture.py",
    "montar": "npm --prefix apps/web run build",
    "guardianes": "node --test \"pruebas/guardianes/*.test.js\"",
    "puerta": "node pruebas/banco/puerta.js",
    "puerta:rapida": "node pruebas/banco/puerta_rapida.js",
    "puerta:pesada": "node pruebas/banco/puerta_pesada.js",
    "puerta:afectadas": "node pruebas/banco/afectadas.js",
    "banco:ronda": "node pruebas/banco/ronda.js",
    "banco:encarga": "node pruebas/banco/encarga.js",
    "banco:quien": "node -e \"console.log(require('./pruebas/banco/turno').quien() || 'turno libre')\"",
    "probar": "node pruebas/prueba3.js",
    "probar:vr": "node pruebas/vr_mock.js",
    "dev:arriba": "node infra/dev/herramientas/levanta.mjs",
    "dev:abajo": "node infra/dev/herramientas/para.mjs",
    "dev:estado": "node infra/dev/herramientas/estado.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "ajv": "8.20.0",
    "fast-check": "4.10.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright-core": "1.64.1",
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.1"
  }
}
