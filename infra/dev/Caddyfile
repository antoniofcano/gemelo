# Caddy del entorno de DESARROLLO (infra/dev/compose.yml). No es el de producción (infra/Caddyfile, otro trabajo).
# Misma forma que producción: portada en /, mundo en /finca/ y teselas tras sesión (forward_auth), api en /api/.
# Diferencias a propósito: sin HSTS (en localhost estorba), CSP en modo Report-Only, certificado de una CA local
# no instalada (tls internal), y la CA se pierde al parar (tmpfs). Ver doc/operacion/DESARROLLO-LOCAL.md.
{
	admin off
	auto_https disable_redirects
	skip_install_trust
	http_port 8080
	https_port 8443
	log {
		output stdout
		format console
	}
}

(cabeceras) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# WebXR, micrófono y cámara (fases 2-4) y geolocalización (corresponsal) solo para este origen
		Permissions-Policy "xr-spatial-tracking=(self), microphone=(self), camera=(self), geolocation=(self), screen-wake-lock=(self), payment=(), usb=(), interest-cohort=()"
		# Report-Only: el navegador avisa en la consola de lo que bloquearía, sin bloquearlo. Las fuentes de Google las pide
		# plantilla.html; el motor pide su mismo origen; data:/blob: para el mosaico y las texturas; LiveKit por WebSocket.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' {$LIVEKIT_PUBLICO}; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	}
}

(gemelo) {
	encode zstd gzip

	import cabeceras

	# salud del propio Caddy (la usa el healthcheck)
	handle /salud {
		header Cache-Control "no-store"
		respond "ok" 200
	}

	# la web aún no trae icono (apps/web no tiene favicon): sin esto el navegador anota un 404 en la consola en cada carga.
	# Lo mismo hace el servidor de pruebas de los guardianes (_navegador.js). Se quita cuando apps/web tenga su icono.
	handle /favicon.ico {
		header Cache-Control "public, max-age=86400"
		respond 204
	}

	# la ruta de autorización es solo para este Caddy (forward_auth), nunca desde fuera
	handle /api/interno/* {
		respond 404
	}

	# la api (apps/api): ella decide su propia autorización
	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000
	}

	# decisión 16: sin sesión, solo la portada. El mundo (/finca/) y las teselas preguntan a la api si hay sesión; sin ella,
	# una navegación va a la portada (303) y una carga recibe 401. Igual que infra/Caddyfile (producción).
	@con_sesion path /finca /finca/* /teselas/*
	handle @con_sesion {
		forward_auth api:8000 {
			uri /api/interno/autoriza
		}
		redir /finca /finca/ 308

		# teselas: /teselas/<finca>/indice.json y /teselas/<finca>/t/<kx>_<ky>.json|jpg (carpeta montada de solo lectura)
		handle_path /teselas/* {
			root * /srv/teselas
			header Cache-Control "private, max-age=300"
			file_server {
				hide .*
			}
		}

		# el mundo: los ficheros de assets/ llevan hash en el nombre (Vite) → caché inmutable; la página, siempre revalidada
		handle_path /finca/* {
			root * /srv/web
			@inmutable path /assets/*
			header @inmutable Cache-Control "public, max-age=31536000, immutable"
			@pagina path / /index.html
			header @pagina Cache-Control "no-cache"
			file_server {
				precompressed br zstd gzip
				hide .*
			}
		}
	}

	# la portada pública (provisional de desarrollo: infra/dev/portada/; la de verdad va con la UX, doc/sistema/UX.md §4.1)
	handle {
		root * /srv/portada
		header Cache-Control "no-cache"
		file_server {
			hide .*
		}
	}
}

# los errores (404…) llevan las mismas cabeceras y nunca se guardan en caché (si no, un 404 en assets/ heredaría «immutable»)
(errores) {
	handle_errors {
		import cabeceras
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

# Por http solo la salud: lo demás va a https. La cookie de sesión es `Secure` (y `__Host-`): la api no la emite si la
# petición no llega por https y Chrome no la guarda desde http://localhost (comprobado el 2026-10-29 con Chrome 131
# headless). Sin https no hay sesión y, sin sesión, solo la portada (decisión 16).
http://:8080 {
	import cabeceras
	handle /salud {
		header Cache-Control "no-store"
		respond "ok" 200
	}
	handle {
		redir https://localhost:{$PUERTO_HTTPS_PUBLICO}{uri} 308
	}
}

https://localhost:8443 {
	tls internal
	import gemelo
	import errores
}
