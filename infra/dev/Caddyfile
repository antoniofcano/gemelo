# Caddy del entorno de DESARROLLO (infra/dev/compose.yml). No es el de producción (infra/Caddyfile, otro trabajo).
# Misma forma que producción: portada en /, mundo en /finca/ y teselas tras sesión (forward_auth), la oficina en /oficina/ tras
# sesión de oficina, api en /api/.
# Diferencias a propósito: sin HSTS (en localhost estorba), CSP en modo Report-Only, certificado de una CA local
# no instalada (tls internal), y la CA se pierde al parar (tmpfs). Ver doc/operacion/DESARROLLO-LOCAL.md.
{
	admin off
	auto_https disable_redirects
	skip_install_trust
	http_port 8080
	https_port 8443
	# a una IP los navegadores no le mandan SNI: sin esto Caddy no sabe qué certificado dar y corta el TLS (alerta 80).
	# «localhost» sin el interruptor; con --red-local, la IP de la red (compose.red-local.yml)
	default_sni {$SNI_POR_DEFECTO}
	log {
		output stdout
		format console
	}
}

(cabeceras) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# WebXR, micrófono y cámara (fases 2-4) y geolocalización (corresponsal) solo para este origen
		Permissions-Policy "xr-spatial-tracking=(self), microphone=(self), camera=(self), geolocation=(self), screen-wake-lock=(self), payment=(), usb=(), interest-cohort=()"
		# Report-Only: el navegador avisa en la consola de lo que bloquearía, sin bloquearlo. Las fuentes de Google las pide
		# plantilla.html; el motor pide su mismo origen (también LiveKit: wss://<sitio>/rtc); data:/blob: para el mosaico y las texturas; blob: también en connect-src (3D Tiles).
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	}
}

(gemelo) {
	encode zstd gzip

	import cabeceras

	# salud del propio Caddy (la usa el healthcheck)
	handle /salud {
		header Cache-Control "no-store"
		respond "ok" 200
	}

	# la web aún no trae icono (apps/web no tiene favicon): sin esto el navegador anota un 404 en la consola en cada carga.
	# Lo mismo hace el servidor de pruebas de los guardianes (_navegador.js). Se quita cuando apps/web tenga su icono.
	handle /favicon.ico {
		header Cache-Control "public, max-age=86400"
		respond 204
	}

	# la ruta de autorización es solo para este Caddy (forward_auth), nunca desde fuera
	handle /api/interno/* {
		respond 404
	}

	# LiveKit (F2): la señalización por el MISMO origen, como en producción (wss://<sitio>/rtc). Así vale igual desde
	# https://localhost y desde la IP de la red local (--red-local), sin abrir 7880 ni mezclar ws:// en una página https.
	# livekit-client añade /rtc/… a la URL que le da la api («/rtc»): Caddy quita el primer /rtc y LiveKit recibe /rtc/….
	# Sin sesión del gemelo: LiveKit exige su propio token (lo firma la api con la sesión). Los datos (WebRTC) van aparte, por
	# ICE: UDP 7882 o TCP 7881 directos a LiveKit (DESARROLLO-LOCAL.md § Presencia).
	handle_path /rtc/* {
		reverse_proxy livekit:7880
	}

	# V7: la subida de una foto (POST /api/medios, hasta GEMELO_MEDIOS_MAX_MB = 8 MB por defecto): ~9 MB de cuerpo (multipart). Solo esa ruta;
	# el resto de /api/* sigue en 1 MB. Si sube GEMELO_MEDIOS_MAX_MB, sube este tope y el de infra/bloque-borde.txt.
	handle /api/medios {
		request_body {
			max_size 9MB
		}
		reverse_proxy api:8000
	}

	# la api (apps/api): ella decide su propia autorización
	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000
	}

	# la oficina (ADR-0024, contratos/sesion.md § Oficina): el build de apps/web/oficina (dist-oficina, build:oficina) en
	# /srv/oficina, solo con sesión de OFICINA (rol oficina o admin con su aparato aprobado). Sin sesión, a la portada (303); con
	# sesión de hogar, 403; con el aparato pendiente, a /api/oficina/pendiente. Igual que infra/Caddyfile (producción).
	@oficina path /oficina /oficina/*
	handle @oficina {
		forward_auth api:8000 {
			uri /api/interno/autoriza?para=oficina
		}
		redir /oficina /oficina/ 308
		handle_path /oficina/* {
			root * /srv/oficina
			@inmutable path /assets/*
			header @inmutable Cache-Control "private, max-age=31536000, immutable"
			@pagina path / /index.html
			header @pagina Cache-Control "no-cache"
			file_server {
				precompressed br zstd gzip
				hide .*
			}
		}
	}

	# decisión 16: sin sesión, solo la portada. El mundo (/finca/), las teselas y los avatares preguntan a la api si hay sesión; sin ella,
	# una navegación va a la portada (303) y una carga recibe 401. Igual que infra/Caddyfile (producción).
	@con_sesion path /finca /finca/* /teselas/* /avatares /avatares/*
	handle @con_sesion {
		forward_auth api:8000 {
			uri /api/interno/autoriza
		}
		redir /finca /finca/ 308

		# los avatares VRM (ADR-0020, contratos/avatares.md): SOLO <id>.vrm y catalogo.json, desde /srv/avatares. Cada .vrm se pide con ?v=<sha256> (el
		# cliente lo añade): la URL cambia con el contenido, así que «immutable» es correcto; el catálogo se revalida. Se sirven los precomprimidos
		# (<id>.vrm.br|zst|gz que escribe tuberia/avatares/construye.mjs) con el tipo del original. Lo demás de esa carpeta da 404.
		@avatares path /avatares /avatares/*
		handle @avatares {
			@avatar_permitido path_regexp ^/avatares/([a-z0-9-]{1,32}\.vrm|catalogo\.json)$
			handle @avatar_permitido {
				@avatar_vrm path_regexp ^/avatares/[a-z0-9-]{1,32}\.vrm$
				header @avatar_vrm {
					Content-Type "model/gltf-binary"
					Cache-Control "private, max-age=31536000, immutable"
				}
				@avatar_catalogo path /avatares/catalogo.json
				header @avatar_catalogo Cache-Control "private, no-cache"
				uri strip_prefix /avatares
				root * /srv/avatares
				file_server {
					precompressed br zstd gzip
					hide .*
				}
			}
			handle {
				header Cache-Control "no-store"
				respond "404 Not Found" 404
			}
		}


		# teselas: /teselas/<finca>/indice.json y /teselas/<finca>/t/<kx>_<ky>.json|jpg (carpeta montada de solo lectura)
		# /teselas/<finca servida>/tileset/… sale de /srv/tileset (3D Tiles) y el resto de esa finca, de /srv/finca (por defecto,
		# lo mismo que /srv/teselas/<finca>; con GEMELO_DEV_FINCA_CARPETA, una salida de referencia); las demás fincas, de /srv/teselas
		handle_path /teselas/* {
			header Cache-Control "private, max-age=300"
			@tileset path /{$FINCA_SERVIDA:hituelo}/tileset/*
			handle @tileset {
				uri strip_prefix /{$FINCA_SERVIDA:hituelo}/tileset
				root * /srv/tileset
				file_server {
					hide .*
				}
			}
			# las recetas horneadas (O7d, contratos/olivo-horneado.md): /teselas/<finca>/olivos/ sale de /srv/olivos (la carpeta que
			# escribe el hornero; GEMELO_DEV_OLIVOS). El objeto se direcciona por su huella: octet-stream ya en brotli e inmutable.
			# El manifiesto de la finca cambia al rehornear: se revalida. Los atlas de los impostores (O8b, contratos/olivo-impostor.md) son
			# <huella>.webp: image/webp, sin Content-Encoding (ya van comprimidos) e inmutables. SOLO se sirven manifiesto.json,
			# <huella de 32 hex>.br y <huella de 32 hex>.webp; lo
			# demás de esa carpeta (estado.json, manifiesto.anterior.json… que escribe el hornero) da 404.
			@olivos path /{$FINCA_SERVIDA:hituelo}/olivos/*
			handle @olivos {
				@permitido path_regexp ^/{$FINCA_SERVIDA:hituelo}/olivos/(manifiesto\.json|[0-9a-f]{32}\.br|[0-9a-f]{32}\.webp)$
				handle @permitido {
					uri strip_prefix /{$FINCA_SERVIDA:hituelo}/olivos
					root * /srv/olivos
					# los matchers de `header` se evalúan ANTES que el `uri strip_prefix` (orden de directivas de Caddy): llevan la ruta entera
					@objeto_horneado path_regexp ^/{$FINCA_SERVIDA:hituelo}/olivos/[0-9a-f]{32}\.br$
					header @objeto_horneado {
						Content-Type "application/octet-stream"
						Content-Encoding "br"
						Cache-Control "private, max-age=31536000, immutable"
					}
					@atlas_impostor path_regexp ^/{$FINCA_SERVIDA:hituelo}/olivos/[0-9a-f]{32}\.webp$
					header @atlas_impostor {
						Content-Type "image/webp"
						Cache-Control "private, max-age=31536000, immutable"
					}
					@manifiesto path /{$FINCA_SERVIDA:hituelo}/olivos/manifiesto.json
					header @manifiesto Cache-Control "private, no-cache"
					file_server {
						hide .*
					}
				}
				handle {
					header Cache-Control "no-store"
					respond "404 Not Found" 404
				}
			}
			@finca path /{$FINCA_SERVIDA:hituelo}/*
			handle @finca {
				uri strip_prefix /{$FINCA_SERVIDA:hituelo}
				root * /srv/finca
				file_server {
					hide .*
				}
			}
			handle {
				root * /srv/teselas
				file_server {
					hide .*
				}
			}
		}

		# el mundo: los ficheros de assets/ llevan hash en el nombre (Vite) → caché inmutable; la página, siempre revalidada
		handle_path /finca/* {
			root * /srv/web
			@inmutable path /assets/*
			header @inmutable Cache-Control "public, max-age=31536000, immutable"
			@pagina path / /index.html
			header @pagina Cache-Control "no-cache"
			file_server {
				precompressed br zstd gzip
				hide .*
			}
		}
	}

	# la portada pública y las pantallas de entrada (apps/web/portada, construida en apps/web/dist-portada; UX.md §4).
	# Como el mundo: assets/ con hash en el nombre → inmutable; la página, siempre revalidada. Igual que infra/Caddyfile.
	handle {
		root * /srv/portada
		@inmutable path /assets/*
		header @inmutable Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		file_server {
			precompressed br zstd gzip
			hide .*
		}
	}
}

# los errores (404…) llevan las mismas cabeceras y nunca se guardan en caché (si no, un 404 en assets/ heredaría «immutable»)
(errores) {
	handle_errors {
		import cabeceras
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

# Por http solo la salud: lo demás va a https. La cookie de sesión es `Secure` (y `__Host-`): la api no la emite si la
# petición no llega por https y Chrome no la guarda desde http://localhost (comprobado el 2026-10-29 con Chrome 131
# headless). Sin https no hay sesión y, sin sesión, solo la portada (decisión 16).
http://:8080 {
	import cabeceras
	handle /salud {
		header Cache-Control "no-store"
		respond "ok" 200
	}
	handle {
		redir https://localhost:{$PUERTO_HTTPS_PUBLICO}{uri} 308
	}
}

# SITIOS: «https://localhost:8443» (compose.yml); con --red-local, también «https://<IP de la red local>:8443»
# (compose.red-local.yml): tls internal emite entonces un certificado de la CA local para esa IP.
{$SITIOS} {
	tls internal
	import gemelo
	import errores
}
