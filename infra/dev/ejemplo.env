# Plantilla de infra/dev/.env (que NO se versiona). `npm run dev:arriba` crea .env con valores ALEATORIOS si no existe;
# este fichero solo documenta las variables y sirve a los guardianes para validar el compose. Ningún valor de aquí es real.

# claves generadas (aleatorias, solo para este equipo)
# Postgres: dueño del esquema (gemelo_dueno: migraciones y siembra) y rol de la api (gemelo_api: solo filas), como en producción
GEMELO_DEV_PG_CLAVE=la-genera-levanta
GEMELO_DEV_PG_API_CLAVE=la-genera-levanta
GEMELO_DEV_LIVEKIT_CLAVE=la-genera-levanta
GEMELO_DEV_LIVEKIT_SECRETO=la-genera-levanta
# firma de la cookie de sesión de la api (≥ 32 caracteres)
GEMELO_DEV_SESION_SECRETO=la-genera-levanta

# puertos del anfitrión (todos en 127.0.0.1)
GEMELO_DEV_PUERTO_WEB=8780
GEMELO_DEV_PUERTO_HTTPS=8743
GEMELO_DEV_PUERTO_DB=55432
GEMELO_DEV_PUERTO_LIVEKIT=7880
# medios de LiveKit en el anfitrión (ICE por TCP y UDP multiplexado); solo se cambian para levantar un segundo entorno a la vez
# (con otro COMPOSE_PROJECT_NAME); los candidatos ICE siguen anunciando 7881/7882, así que el audio solo vale con los de siempre
GEMELO_DEV_PUERTO_LIVEKIT_TCP=7881
GEMELO_DEV_PUERTO_LIVEKIT_UDP=7882
GEMELO_DEV_PUERTO_CORREO_WEB=8025
GEMELO_DEV_PUERTO_SMTP=1025

# LiveKit: por defecto con --dev (registro de depuración). Para arrancarlo como en producción:
# GEMELO_DEV_LIVEKIT_ARGS=--config /etc/livekit.yaml

# datos: por defecto el fixture sintético (pruebas/salida/fixture). Para datos reales, una carpeta FUERA del repo con
# <finca>/indice.json y <finca>/t/ (ruta absoluta). GEMELO_DEV_FINCA elige la finca con la que se construye la web.
# GEMELO_DEV_TESELAS=
# GEMELO_DEV_FINCA=hituelo
# Hituelo v3: la salida de referencia de UNA finca (con indice.json y t/ directamente dentro) y su tileset 3D Tiles (con
# tileset.json), ambas FUERA del repo; se sirven en /teselas/<GEMELO_DEV_FINCA>/ y /teselas/<GEMELO_DEV_FINCA>/tileset/.
# GEMELO_DEV_FINCA_CARPETA=
# GEMELO_DEV_TILESET=

# prueba en aparatos (npm run dev:arriba -- --red-local): abre SOLO el https de la web en la IP de la red local del
# equipo. Si no se pone, la detecta levanta.mjs (primero la WiFi); solo se acepta una IPv4 privada.
# GEMELO_DEV_IP=
