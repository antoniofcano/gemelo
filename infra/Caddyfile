# Caddy INTERNO del gemelo (detrás del Caddy de borde de Oficultor, que termina TLS: ADR-0011).
# Lo comprueba infra/probar-caddy.sh (cabeceras, caché, sesión y redacción de los registros).
#   /                      portada pública (sin sesión: decisión 16)
#   /finca/…, /teselas/…, /avatares/…   solo con sesión (forward_auth a la api)
#   /oficina/…             solo con sesión de OFICINA (forward_auth a la api con ?para=oficina, ADR-0024)
#   /api/…                 api (la api decide su propia autorización; /api/avisos/baja va sin sesión: la protege su firma)
#   /rtc/…                 señalización de LiveKit (perfil `presencia` del compose; apagado, 502)
{
	admin off
	auto_https off
	servers {
		# el borde está en la red de Docker: su X-Forwarded-For es de fiar; el de un cliente directo, no
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

(cabeceras_seguridad) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# el micrófono, para este origen: la voz de las visitas guiadas (F3, ADR-0026); con microphone=() el navegador lo niega sin preguntar
		Permissions-Policy "xr-spatial-tracking=(self), microphone=(self), camera=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=()"
		# CSP estricta en modo SOLO INFORME (fase F1a): se mira lo que rompería antes de imponerla
		# Los modelos de mandos y manos en VR (I6) van en /finca/xr/perfiles/, del mismo origen: connect-src 'self' (los glb y json se piden
		# con fetch) e img-src blob: (sus texturas) bastan; no hace falta abrir cdn.jsdelivr.net, de donde los bajaría three por defecto
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob:; worker-src 'self' blob:; media-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; report-uri /api/csp-informe"
		-Server
		-Via
	}
}

:8080 {
	import cabeceras_seguridad

	log {
		output stdout
		format filter {
			wrap json
			# nada de credenciales en los registros: ni cookies, ni Authorization, ni el token del enlace (?t=)
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>X-Forwarded-For delete
			resp_headers>Set-Cookie delete
			request>uri query {
				replace t REDACTADO
				# el token de LiveKit viaja en la URL del WebSocket de /rtc
				replace access_token REDACTADO
			}
			# la IP, recortada: basta para ver un abuso y no identifica un hogar
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
		}
	}

	# la ruta de autorización es solo para este Caddy, nunca desde fuera
	handle /api/interno/* {
		respond 404
	}

	# LiveKit (F2/F3, ADR-0027): la señalización por el MISMO origen (wss://<sitio>/rtc), sin sesión del gemelo: LiveKit exige su propio token, que firma
	# la api. livekit-client añade /rtc/… a la URL que le da la api («/rtc»): Caddy quita el primer /rtc y LiveKit recibe /rtc/…. Los medios (WebRTC) van aparte, directos a LiveKit por 7881/tcp y 7882/udp.
	handle_path /rtc/* {
		reverse_proxy livekit:7880
	}

	# V7: la subida de una foto (POST /api/medios, hasta GEMELO_MEDIOS_MAX_MB = 8 MB por defecto): ~9 MB de cuerpo (multipart). Solo esa ruta;
	# el resto de /api/* sigue en 1 MB. Si sube GEMELO_MEDIOS_MAX_MB, sube este tope y el de infra/bloque-borde.txt.
	handle /api/medios {
		request_body {
			max_size 9MB
		}
		reverse_proxy api:8000
	}

	# OF3b: el contorno de una finca (PUT /api/admin/fincas/<finca>/contorno, GeoJSON de hasta 50.000 vértices): la api admite 4 MiB; el resto de /api/*
	# sigue en 1 MB. Matcher de RUTA en línea y no con nombre: Caddy ordena los handle por ruta y uno con nombre quedaría detrás de /api/*.
	handle /api/admin/fincas/*/contorno {
		request_body {
			max_size 5MB
		}
		reverse_proxy api:8000
	}

	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000
	}

	# la oficina (ADR-0024, contratos/sesion.md § Oficina; el build de apps/web/oficina en /srv/oficina): solo con sesión de
	# OFICINA (rol oficina o admin con su aparato aprobado). Sin sesión, a la portada (303); con sesión de hogar, 403; con el
	# aparato pendiente, a /api/oficina/pendiente. La api vuelve a mirar el rol en cada ruta: esto no es la única barrera.
	@oficina path /oficina /oficina/*
	handle @oficina {
		forward_auth api:8000 {
			uri /api/interno/autoriza?para=oficina
		}
		# assets/ con hash en el nombre (Vite) → inmutable, pero privado (tras sesión); la página, siempre revalidada
		@oficina_inmutable path /oficina/assets/*
		header @oficina_inmutable Cache-Control "private, max-age=31536000, immutable"
		@oficina_html path /oficina /oficina/ /oficina/*.html
		header @oficina_html Cache-Control "no-cache"
		redir /oficina /oficina/ 308
		root * /srv
		encode zstd gzip
		file_server
	}

	@con_sesion path /finca /finca/* /teselas/* /avatares /avatares/*
	handle @con_sesion {
		forward_auth api:8000 {
			uri /api/interno/autoriza
		}

		# los avatares VRM (ADR-0020, contratos/avatares.md): SOLO <id>.vrm y catalogo.json, desde /srv/avatares. Cada .vrm se pide con ?v=<sha256> (el
		# cliente lo añade): la URL cambia con el contenido, así que «immutable» es correcto; el catálogo se revalida. Se sirven los precomprimidos
		# (<id>.vrm.br|zst|gz que escribe tuberia/avatares/construye.mjs) con el tipo del original. Lo demás de esa carpeta da 404.
		@avatares path /avatares /avatares/*
		handle @avatares {
			@avatar_permitido path_regexp ^/avatares/([a-z0-9-]{1,32}\.vrm|catalogo\.json)$
			handle @avatar_permitido {
				@avatar_vrm path_regexp ^/avatares/[a-z0-9-]{1,32}\.vrm$
				header @avatar_vrm {
					Content-Type "model/gltf-binary"
					Cache-Control "private, max-age=31536000, immutable"
				}
				@avatar_catalogo path /avatares/catalogo.json
				header @avatar_catalogo Cache-Control "private, no-cache"
				uri strip_prefix /avatares
				root * /srv/avatares
				file_server {
					precompressed br zstd gzip
					hide .*
				}
			}
			handle {
				header Cache-Control "no-store"
				respond "404 Not Found" 404
			}
		}

		@inmutable path /finca/assets/*
		header @inmutable Cache-Control "public, max-age=31536000, immutable"
		# las recetas horneadas (O7d, contratos/olivo-horneado.md; en /srv/teselas/<finca>/olivos/): el objeto lleva su huella (32 hex)
		# en el nombre y ya viene en brotli → inmutable; el manifiesto de la finca cambia al rehornear → se revalida. SOLO se sirven
		# esos dos y los atlas .webp de abajo: lo demás de la carpeta (estado.json, manifiesto.anterior.json… del hornero) da 404.
		# Los matchers son excluyentes:
		# el resultado no depende del orden de los `header`.
		@olivos_objeto path_regexp ^/teselas/[^/]+/olivos/[0-9a-f]{32}\.br$
		header @olivos_objeto {
			Content-Type "application/octet-stream"
			Content-Encoding "br"
			Cache-Control "private, max-age=31536000, immutable"
		}
		# los atlas de los impostores (O8b, contratos/olivo-impostor.md): <huella>.webp, image/webp sin Content-Encoding (ya comprimidos), inmutables
		@olivos_atlas path_regexp ^/teselas/[^/]+/olivos/[0-9a-f]{32}\.webp$
		header @olivos_atlas {
			Content-Type "image/webp"
			Cache-Control "private, max-age=31536000, immutable"
		}
		@olivos_manifiesto path_regexp ^/teselas/[^/]+/olivos/manifiesto\.json$
		header @olivos_manifiesto Cache-Control "private, no-cache"
		@olivos_otros {
			path_regexp ^/teselas/[^/]+/olivos(/|$)
			not path_regexp ^/teselas/[^/]+/olivos/(manifiesto\.json|[0-9a-f]{32}\.br|[0-9a-f]{32}\.webp)$
		}
		header @olivos_otros Cache-Control "no-store"
		respond @olivos_otros "404 Not Found" 404
		@teselas {
			path /teselas/*
			not path_regexp ^/teselas/[^/]+/olivos(/|$)
		}
		header @teselas Cache-Control "private, max-age=3600"
		@html path /finca /finca/ /finca/*.html
		header @html Cache-Control "no-cache"
		redir /finca /finca/ 308
		root * /srv
		encode zstd gzip
		file_server
	}

	handle {
		root * /srv/portada
		@inmutable path /assets/*
		header @inmutable Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		encode zstd gzip
		file_server
	}

	# los errores (404…) llevan las mismas cabeceras y nunca se guardan en caché (si no, un 404 en assets/ heredaría «immutable»); igual que infra/dev/Caddyfile
	handle_errors {
		import cabeceras_seguridad
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
