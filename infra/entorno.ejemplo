# Plantilla de /etc/gemelo/entorno en el VPS (la lee infra/compose.yml con env_file). SIN SECRETOS: los secretos van
# en ficheros de /etc/gemelo/secretos/ (0440, legibles solo por el uid del contenedor que los usa: RUNBOOK-VPS,
# «Secretos»), y el compose los monta como secretos de Docker:
#   pg_dueno        contraseña del dueño de la base (migraciones)
#   pg_api          contraseña del rol gemelo_api (la api)
#   sesion_secreto  ≥ 32 caracteres aleatorios para firmar la cookie (openssl rand -base64 48)
#   smtp_clave      contraseña del buzón SMTP de OVH
#   ot_token        token PROPIO de solo lectura de OlivarTrack (decisión 17)
#   vigia_token     token de Vigía, solo lectura («no» mientras GEMELO_VIGIA=no)
#   livekit_secreto API secret de LiveKit, ≥ 32 caracteres aleatorios (openssl rand -base64 48); lo lee la api
#   livekit_claves  el mismo par para el servidor LiveKit, una línea YAML «<GEMELO_LIVEKIT_CLAVE>: <secreto>»
# Lo carga también infra/respaldo.sh, solo sus líneas GEMELO_RESPALDO_*. Nada de este fichero se versiona con valores reales. Copia: sudo install -m 0640 infra/entorno.ejemplo /etc/gemelo/entorno

# --- web
GEMELO_URL_PUBLICA=https://gemelo.canoydamas.es
# borde de Oficultor + Caddy interno
GEMELO_API_PROXIES=2
GEMELO_API_REGISTRO=info

# --- sesión (ADR-0013)
GEMELO_SESION_DIAS=30
GEMELO_SESION_INACTIVIDAD_DIAS=7
GEMELO_ENLACE_POR_IP=10
GEMELO_ENLACE_POR_CORREO=3
GEMELO_ENLACE_VENTANA_MIN=15
# código corto de las gafas (contratos/sesion.md § Código corto): códigos por IP, intentos de aprobar por hogar y por IP
# (en la ventana), y sondeos por minuto y por IP
GEMELO_VINCULO_POR_IP=10
GEMELO_VINCULO_INTENTOS_POR_HOGAR=5
GEMELO_VINCULO_INTENTOS_POR_IP=10
GEMELO_VINCULO_SONDEOS_POR_MIN=60
GEMELO_VINCULO_VENTANA_MIN=15
# sesión de oficina (ADR-0024, contratos/sesion.md § Oficina): horas absolutas, minutos sin actividad, minutos que vale la
# «confirmación reciente» y minutos que hay que esperar para aprobar un aparato con un segundo enlace (≥ 5 en producción)
GEMELO_OFICINA_SESION_HORAS=12
GEMELO_OFICINA_INACTIVIDAD_MIN=120
GEMELO_OFICINA_CONFIRMACION_MIN=15
GEMELO_OFICINA_SEGUNDO_ENLACE_MIN=5
# llave de acceso (WebAuthn, passkey) de la oficina (OF13, contratos/sesion.md § Llave de acceso): «obligatoria» por defecto;
# «no» solo fuera de producción (en producción la api no arranca con «no»). El RP ID y el origen salen de GEMELO_URL_PUBLICA;
# solo se ponen si la oficina se sirve en otro origen (el RP ID es su dominio o uno de sus padres, nunca una IP).
GEMELO_OFICINA_LLAVE=obligatoria
# GEMELO_LLAVE_RP_ID=gemelo.canoydamas.es
# GEMELO_LLAVE_ORIGEN=https://gemelo.canoydamas.es

# --- correo del enlace mágico: SMTP de OVH (decisión 15) [NO VERIFICADO contra el buzón real]
# Pasos y comprobaciones del dominio (MX, SPF, DKIM, DMARC): doc/operacion/RUNBOOK-VPS.md, «SMTP de OVH».
# En producción la api exige smtp, TLS y usuario. La clave del buzón NO va aquí: /etc/gemelo/secretos/smtp_clave.
GEMELO_CORREO=smtp
# servidor según el producto de correo de OVH que aloje el buzón [SUPUESTO: ssl0.ovh.net es el de MX Plan]
GEMELO_SMTP_HOST=ssl0.ovh.net
# 465 = TLS directo; 587 = STARTTLS (la api lo exige)
GEMELO_SMTP_PUERTO=465
GEMELO_SMTP_TLS=si
# la dirección completa de un buzón PROPIO del gemelo en el dominio canoydamas.es (no la de una persona)
GEMELO_SMTP_USUARIO=buzon-del-gemelo@ejemplo.invalid
# la MISMA dirección que el usuario [SUPUESTO: OVH rechaza o marca un remitente distinto del buzón autenticado]
GEMELO_CORREO_REMITENTE=Gemelo del olivar <buzon-del-gemelo@ejemplo.invalid>
# Avisos de la campana y .ics de la Agenda por correo a los hogares que lo pidieron (OF11c, contratos/avisos-correo.md): mismo buzón de arriba
GEMELO_CORREO_AVISOS=si
GEMELO_CORREO_REINTENTOS=5
GEMELO_CORREO_AVISOS_CADA_SEG=60

# --- OlivarTrack por MCP, solo lectura (contratos/olivartrack-sync.md). «no» hasta que exista el token propio
# (decisión 17) y se hayan ajustado las formas de respuesta reales. El token NO va aquí: /etc/gemelo/secretos/ot_token.
# Qué pedir en OlivarTrack, cómo se pasa y cómo se revoca: doc/operacion/RUNBOOK-VPS.md, «Token propio de OlivarTrack».
GEMELO_OT=no
# GEMELO_OT=mcp
# la URL del MCP de OlivarTrack (https obligatorio en producción)
# GEMELO_OT_MCP_URL=https://olivartrack.ejemplo.invalid/mcp
GEMELO_OT_CADA_MIN=60
# «pasar a OlivarTrack» desde la bandeja: «manual» (la persona copia el texto). «token» está reservado para el token de solo proponer y aún no cambia nada
GEMELO_OFICINA_OT_PROPONER=manual

# --- el tiempo de Vigía por MCP, solo lectura (contratos/tiempo.md): GET /api/tiempo, actual y previsión de 72 h, con caché en
# memoria (10 min el actual, 1 h la previsión). «no» hasta que Antonio dé la URL y el token; «fixture» solo fuera de producción.
# El token NO va aquí: /etc/gemelo/secretos/vigia_token (el compose lo monta siempre: el fichero debe existir, con «no» hasta tenerlo).
GEMELO_VIGIA=no
# GEMELO_VIGIA=mcp
# la URL del MCP de Vigía (https obligatorio en producción)
# GEMELO_VIGIA_MCP_URL=https://vigia.ejemplo.invalid/mcp

# --- presencia compartida (F2, LiveKit). Sin GEMELO_LIVEKIT_URL la api la deja apagada (POST /api/presencia/token → 503).
# El secreto (API secret, ≥ 32 caracteres) NO va aquí: /etc/gemelo/secretos/livekit_secreto (el compose lo monta y pone
# GEMELO_LIVEKIT_SECRETO_FICHERO). La URL pública puede ser wss://… o la ruta del mismo origen /rtc (el borde la pasa a LiveKit).
# Se enciende junto con el perfil `presencia` del compose (ADR-0027): el servidor LiveKit lee su par de /etc/gemelo/secretos/livekit_claves.
# GEMELO_LIVEKIT_URL=http://livekit:7880
# GEMELO_LIVEKIT_URL_PUBLICA=/rtc
# GEMELO_LIVEKIT_CLAVE=<nombre de la clave, el mismo de livekit_claves>
# para el contenedor de LiveKit: la IP pública del VPS, el candidato ICE que anuncia (sin ella, los medios no llegan)
# NODE_IP=<IP pública del VPS>
# --- fotos de los hogares (V7, contratos/vida.md). El compose fija GEMELO_MEDIOS=/datos/medios (volumen `medios`, que entra en las copias)
# y GEMELO_CONFIG_SALIDA=/datos/config/publicada.json (volumen `config_publicada`, para el hornero): no se ponen aquí.
# Tope por foto en MB (1–16): el Caddy interno y el de borde dejan pasar POST /api/medios hasta 9 MB; si lo subes de 8, sube también
# max_size de /api/medios en infra/Caddyfile y en el bloque de borde.
GEMELO_MEDIOS_MAX_MB=8
# días que se conserva una foto retirada antes de borrarla del volumen, y subidas por hogar y hora
GEMELO_MEDIOS_RETENCION_DIAS=30
GEMELO_MEDIOS_SUBIDAS_HORA=20
# escrituras de la vida de las hazas (nombres, pinturas, denuncias…) por hogar y hora
GEMELO_VIDA_ESCRITURAS_HORA=60

# --- copias (infra/respaldo.sh; no las lee la api)
# destino de rclone FUERA del VPS (p. ej. Object Storage de OVH en otra región): «remoto:cubo/ruta»
GEMELO_RESPALDO_REMOTO=respaldo-ovh:gemelo-respaldos/bd
# clave PÚBLICA de age: en el VPS solo está la pública; la privada la guarda Antonio fuera
GEMELO_RESPALDO_DESTINATARIO_FICHERO=/etc/gemelo/respaldo.age.pub
GEMELO_RESPALDO_LOCAL=/var/backups/gemelo
GEMELO_RESPALDO_DIAS_LOCALES=7
# V7: copiar también el volumen de medios (fotos), cifrado igual y subido junto a la base. «no» lo omite
GEMELO_RESPALDO_MEDIOS=si
GEMELO_RESPALDO_CONTENEDOR_API=gemelo-api-1
