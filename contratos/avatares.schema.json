{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemelo.invalid/contratos/avatares.schema.json",
  "$comment": "Catálogo de avatares (/avatares/catalogo.json; contratos/avatares.md, ADR-0020 §2 y ADR-0025). v1: avatares VRM cerrados. v2: cuerpos con sus piezas dentro, paletas y, opcionales, los cerrados. Lo escriben tuberia/avatares/construye.mjs (v1) y tuberia/avatares/creador/catalogo.mjs (v2) y lo valida ajv ahí y en pruebas/guardianes/avatares.test.js. Lo que un esquema no dice (fichero = id + .vrm, sha256 del fichero, topes, ids únicos, piezas de cada cuerpo que existen, paletas iguales a las del motor) lo comprueba el guardián en código.",
  "title": "avatares",
  "oneOf": [
    {
      "$ref": "#/$defs/catalogo_v1"
    },
    {
      "$ref": "#/$defs/catalogo_v2"
    }
  ],
  "$defs": {
    "avatar": {
      "type": "object",
      "required": [
        "id",
        "nombre",
        "fichero",
        "sha256",
        "bytes",
        "vrm_version",
        "triangulos",
        "primitivas",
        "materiales",
        "texturas",
        "autor",
        "licencia",
        "fuente",
        "colores_muneco"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$",
          "$comment": "es el que viaja en los metadatos de presencia (avatar.vrm) y en la tabla avatares"
        },
        "nombre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "descripcion": {
          "type": "string",
          "maxLength": 200,
          "$comment": "texto alternativo de la portada (accesibilidad, P7d)"
        },
        "fichero": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}\\.vrm$",
          "$comment": "siempre <id>.vrm, relativo a /avatares/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "$comment": "huella del fichero tal como se sirve; el cliente lo comprueba y lo añade a la URL (?v=) para que la caché inmutable sea correcta"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "vrm_version": {
          "enum": [
            "1.0",
            "0.x"
          ]
        },
        "triangulos": {
          "type": "integer",
          "minimum": 1
        },
        "primitivas": {
          "type": "integer",
          "minimum": 1,
          "$comment": "≈ llamadas de dibujo por avatar"
        },
        "materiales": {
          "type": "integer",
          "minimum": 1
        },
        "texturas": {
          "type": "integer",
          "minimum": 0
        },
        "contornos_quitados": {
          "type": "integer",
          "minimum": 0,
          "$comment": "materiales MToon a los que se les apagó el contorno (segunda pasada de dibujo)"
        },
        "autor": {
          "type": "string",
          "minLength": 1
        },
        "licencia": {
          "$ref": "#/$defs/licencia"
        },
        "fuente": {
          "$ref": "#/$defs/fuente"
        },
        "colores_muneco": {
          "type": "object",
          "required": [
            "camisa",
            "piel",
            "sombrero"
          ],
          "additionalProperties": false,
          "properties": {
            "camisa": {
              "type": "string",
              "pattern": "^#[0-9a-f]{6}$"
            },
            "piel": {
              "type": "string",
              "pattern": "^#[0-9a-f]{6}$"
            },
            "sombrero": {
              "enum": [
                "ninguno",
                "paja",
                "gorra"
              ]
            }
          },
          "$comment": "cómo se pinta el muñeco de lejos (ADR-0020 §5); sombrero, el mismo enum de PUT /api/yo/avatar"
        }
      }
    },
    "topes": {
      "type": "object",
      "required": [
        "triangulos_objetivo",
        "triangulos_max",
        "bytes_max",
        "textura_px_max",
        "texturas_max",
        "materiales_max"
      ],
      "additionalProperties": false,
      "properties": {
        "triangulos_objetivo": {
          "type": "integer",
          "minimum": 1
        },
        "triangulos_max": {
          "type": "integer",
          "minimum": 1
        },
        "bytes_max": {
          "type": "integer",
          "minimum": 1
        },
        "textura_px_max": {
          "type": "integer",
          "minimum": 1
        },
        "texturas_max": {
          "type": "integer",
          "minimum": 1
        },
        "materiales_max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "$comment": "los topes con los que se construyó: el cliente puede mostrarlos o ignorarlos; el guardián comprueba que cada avatar los cumple"
    },
    "color_nombrado": {
      "type": "object",
      "required": [
        "id",
        "nombre",
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$"
        },
        "nombre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        }
      }
    },
    "cuerpo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nombre",
        "edad",
        "complexion",
        "ofrecer",
        "fichero",
        "sha256",
        "bytes",
        "vrm_version",
        "triangulos",
        "primitivas",
        "materiales",
        "texturas",
        "autor",
        "licencia",
        "fuente",
        "piezas",
        "mirada"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$"
        },
        "nombre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "descripcion": {
          "type": "string",
          "maxLength": 200
        },
        "edad": {
          "enum": [
            "peque",
            "joven",
            "adulta",
            "mayor"
          ],
          "$comment": "criterio C1; sin campo de sexo ni de género (C8)"
        },
        "complexion": {
          "enum": [
            "delgada",
            "media",
            "ancha"
          ]
        },
        "ofrecer": {
          "type": "boolean",
          "$comment": "false = diseñado y no ofrecido (peques, decisión 132): la portada no lo enseña y el motor lo trata como ausente"
        },
        "fichero": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}\\.vrm$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "vrm_version": {
          "enum": [
            "1.0",
            "0.x"
          ]
        },
        "triangulos": {
          "type": "integer",
          "minimum": 1,
          "$comment": "del cuerpo solo (sin piezas)"
        },
        "primitivas": {
          "type": "integer",
          "minimum": 1,
          "$comment": "del cuerpo solo"
        },
        "materiales": {
          "type": "integer",
          "minimum": 1,
          "$comment": "del fichero entero"
        },
        "texturas": {
          "type": "integer",
          "minimum": 0
        },
        "autor": {
          "type": "string",
          "minLength": 1
        },
        "licencia": {
          "$ref": "#/$defs/licencia"
        },
        "fuente": {
          "$ref": "#/$defs/fuente"
        },
        "piezas": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$"
          },
          "$comment": "ids de piezas[] que trae este VRM dentro"
        },
        "mirada": {
          "enum": [
            "huesos",
            "expresion",
            "ninguna"
          ],
          "$comment": "si VRMLookAt mueve los ojos: «huesos» (leftEye/rightEye), «expresion» (lookLeft…), «ninguna»"
        }
      }
    },
    "pieza": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tipo",
        "nombre",
        "malla",
        "materiales",
        "triangulos"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$"
        },
        "tipo": {
          "enum": [
            "pelo",
            "vello",
            "ropa",
            "accesorio"
          ]
        },
        "nombre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "malla": {
          "type": "string",
          "pattern": "^pieza_[a-z0-9-]{1,32}$",
          "$comment": "nombre del nodo dentro del VRM de cada cuerpo (three quita los puntos de los nombres: por eso «_»)"
        },
        "materiales": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "enum": [
              "pelo",
              "ropa_base",
              "ropa_abajo",
              "sombrero"
            ]
          },
          "$comment": "con qué se tiñe: pelo ← pelo_color; ropa_base ← arriba; ropa_abajo ← abajo; sombrero ← color"
        },
        "triangulos": {
          "type": "integer",
          "minimum": 1,
          "$comment": "el máximo entre los cuerpos"
        },
        "cubre_ropa_base": {
          "type": "boolean",
          "$comment": "true: con esta pieza el motor no dibuja la ropa base del cuerpo (va debajo)"
        },
        "sombrero": {
          "enum": [
            "paja",
            "gorra"
          ],
          "$comment": "el sombrero del muñeco (avatar.sombrero) que equivale a esta pieza"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "edades": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "peque",
              "joven",
              "adulta",
              "mayor"
            ]
          },
          "$comment": "por talla, nunca por sexo (C5); sin él, todas"
        }
      }
    },
    "licencia": {
      "type": "object",
      "required": [
        "spdx",
        "url",
        "credito_obligatorio",
        "texto_credito"
      ],
      "additionalProperties": false,
      "properties": {
        "spdx": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+-]+$",
          "$comment": "CC0-1.0, CC-BY-4.0… (LicenseRef-… si es propia); lo declara quien da de alta el avatar y la tubería lo contrasta con el meta del VRM"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "credito_obligatorio": {
          "type": "boolean",
          "$comment": "true → la portada lo muestra en «Créditos»"
        },
        "texto_credito": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fuente": {
      "type": "object",
      "required": [
        "nombre"
      ],
      "additionalProperties": false,
      "properties": {
        "nombre": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "catalogo_v1": {
      "type": "object",
      "required": [
        "v",
        "compresion",
        "topes",
        "avatares"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "$comment": "versión del contrato del catálogo"
        },
        "compresion": {
          "enum": [
            "cuantizacion",
            "meshopt",
            "ninguna"
          ],
          "$comment": "cómo van las mallas: cuantizacion = KHR_mesh_quantization (sin WebAssembly); meshopt exigiría 'wasm-unsafe-eval' en la CSP"
        },
        "topes": {
          "$ref": "#/$defs/topes"
        },
        "avatares": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/avatar"
          },
          "$comment": "catálogo cerrado de 6-12 (ADR-0020 §2); hasta que los propios lleguen, los 3-4 CC0 provisionales"
        }
      },
      "$comment": "v1 (P7b): solo avatares cerrados. Un cliente que solo conoce v1 trata cualquier otra versión como «sin catálogo» (el muñeco)."
    },
    "catalogo_v2": {
      "type": "object",
      "required": [
        "v",
        "compresion",
        "topes",
        "topes_combinacion",
        "paletas",
        "cuerpos",
        "piezas"
      ],
      "additionalProperties": false,
      "$comment": "v2 (AV4, ADR-0025): cuerpos con sus piezas dentro (un VRM por cuerpo), paletas para teñir en el motor y, opcionales, los avatares cerrados de v1 (provisionales, decisión 134). La elección de cada persona es la receta de los metadatos de presencia (contratos/presencia.md).",
      "properties": {
        "v": {
          "const": 2
        },
        "compresion": {
          "enum": [
            "cuantizacion",
            "meshopt",
            "ninguna"
          ]
        },
        "topes": {
          "$ref": "#/$defs/topes",
          "$comment": "los del FICHERO de cada cuerpo (lleva todas sus piezas, aunque se dibujen pocas)"
        },
        "topes_combinacion": {
          "type": "object",
          "required": [
            "triangulos",
            "primitivas"
          ],
          "additionalProperties": false,
          "properties": {
            "triangulos": {
              "type": "integer",
              "minimum": 1
            },
            "primitivas": {
              "type": "integer",
              "minimum": 1
            }
          },
          "$comment": "lo que se DIBUJA de un avatar completo (cuerpo + la pieza más cara de cada tipo): lo que cuenta para el Quest (26b dibuja 3 a la vez)"
        },
        "paletas": {
          "type": "object",
          "required": [
            "piel",
            "ropa",
            "pelo"
          ],
          "additionalProperties": false,
          "properties": {
            "piel": {
              "type": "array",
              "minItems": 10,
              "maxItems": 10,
              "items": {
                "$ref": "#/$defs/color_nombrado"
              },
              "$comment": "índice = receta.tono (0-9); de muy claro a muy oscuro (criterio C2); los mismos que Aspecto.PIELES del motor"
            },
            "ropa": {
              "type": "array",
              "minItems": 10,
              "maxItems": 10,
              "items": {
                "$ref": "#/$defs/color_nombrado"
              },
              "$comment": "índice = receta.arriba / receta.abajo (0-9); nombres del campo (C5); los de Aspecto.ROPA"
            },
            "pelo": {
              "type": "array",
              "minItems": 7,
              "maxItems": 10,
              "items": {
                "$ref": "#/$defs/color_nombrado"
              },
              "$comment": "índice = receta.pelo_color; con canas y blanco (C4); los de Aspecto.PELO"
            }
          }
        },
        "cuerpos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/cuerpo"
          }
        },
        "piezas": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/pieza"
          }
        },
        "avatares": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/avatar"
          },
          "$comment": "los cerrados de v1 (provisionales); se eligen con avatar.vrm como en v1"
        }
      }
    }
  }
}
