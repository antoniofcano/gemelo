{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biodiversidad.schema.json",
  "title": "Aves de GBIF por especie y mes en el cuadro de 10 km de una finca (EV-1g, v 1)",
  "description": "Lo escribe tuberia/biodiversidad/gbif_aves.py (fuera del repo) y se publica junto al índice de la finca como biodiversidad.json; lo lee el motor (apps/web/motor/52_aves_mes.js). DEDUCIDO: registros de GBIF en 10 km, no observado en la finca. Solo licencias CC0, CC BY y CC BY-SA (decisión 198). No lleva el centro ni el cuadro: solo su lado.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "origen", "grupo", "generado", "cuadro_km", "anios", "descarga", "atribucion", "fuentes", "especies"],
  "properties": {
    "v": { "const": 1 },
    "origen": { "const": "gbif" },
    "sintetico": { "type": "boolean", "description": "true solo en el ejemplo y los fixtures: las cifras son inventadas" },
    "grupo": { "const": "aves" },
    "generado": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "cuadro_km": { "type": "number", "exclusiveMinimum": 0, "maximum": 50 },
    "anios": {
      "type": "object", "additionalProperties": false, "required": ["desde", "hasta"],
      "properties": { "desde": { "type": "integer", "minimum": 1900 }, "hasta": { "type": "integer", "minimum": 1900 } }
    },
    "descarga": {
      "type": "object", "additionalProperties": false, "required": ["fecha", "via", "consulta", "cita"],
      "properties": {
        "fecha": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "via": { "type": "string", "minLength": 1 },
        "consulta": { "type": "string", "minLength": 1 },
        "cita": { "type": "string", "minLength": 1 },
        "doi": { "type": ["string", "null"], "description": "DOI de una descarga de GBIF con cuenta, si se hizo; la API pública no lo da y entonces va cada conjunto en fuentes" }
      }
    },
    "atribucion": { "type": "string", "minLength": 1, "description": "frase que el motor enseña tal cual junto a la ficha" },
    "fuentes": {
      "type": "array",
      "description": "los conjuntos de datos de GBIF de los que salen los registros contados, cada uno con su cita, su DOI (si lo tiene) y las licencias de lo contado",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "titulo", "doi", "cita", "licencias", "registros"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "titulo": { "type": "string", "minLength": 1 },
          "doi": { "type": ["string", "null"] },
          "cita": { "type": "string", "minLength": 1 },
          "licencias": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["CC0_1_0", "CC_BY_4_0", "CC_BY_SA_4_0"] } },
          "registros": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "especies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["taxon_key", "nombre_cientifico", "meses"],
        "properties": {
          "taxon_key": { "type": "integer", "minimum": 1 },
          "nombre_cientifico": { "type": "string", "minLength": 1 },
          "nombre_comun": { "type": "string", "minLength": 1 },
          "meses": {
            "type": "array", "minItems": 12, "maxItems": 12,
            "description": "enero a diciembre: registros de ese mes sumados en todos los años, y en cuántos años distintos hay alguno",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["n", "anios"],
              "properties": { "n": { "type": "integer", "minimum": 0 }, "anios": { "type": "integer", "minimum": 0, "maximum": 200 } }
            }
          }
        }
      }
    }
  }
}
